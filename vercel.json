{
  "functions": {
    "api/og.js": {
      "runtime": "edge"
    },
    "api/index.js": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    {
      "source": "/api/og",
      "destination": "/api/og"
    },
    {
      "source": "/api/index",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/api/index"
    }
  ]
}
