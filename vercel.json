{
  "functions": {
    "api/og.js": {
      "runtime": "edge"
    },
    "api/index.js": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/api/index"
    }
  ]
}
